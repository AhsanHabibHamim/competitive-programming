{
  // ---------- Editor look & feel ----------
  "editor.fontSize": 16,
  "editor.fontFamily": "'Fira Code', 'JetBrains Mono', 'Ubuntu Mono', monospace",
  "editor.fontLigatures": true,
  "editor.lineHeight": 1.6,
  "editor.tabSize": 4,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  "editor.minimap.enabled": false,
  "editor.rulers": [100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.smoothScrolling": true,
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.formatOnSave": true,
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "workbench.iconTheme": "material-icon-theme",
  "workbench.startupEditor": "none",
  "explorer.compactFolders": false,
  "terminal.integrated.fontSize": 15,

  // ---------- Files ----------
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 800,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    ".build": true,
    ".cph": true
  },

  // ---------- C / C++ ----------
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_style": "file",
  "C_Cpp.clang_format_fallbackStyle": "LLVM",
  "C_Cpp.errorSquiggles": "enabled",
  "C_Cpp.intelliSenseEngine": "default",
  "[c]":   { "editor.defaultFormatter": "ms-vscode.cpptools" },
  "[cpp]": { "editor.defaultFormatter": "ms-vscode.cpptools" },

  // ---------- Code Runner (top-right ▶ button / Ctrl+Alt+N) ----------
  "code-runner.runInTerminal": true,
  "code-runner.saveFileBeforeRun": true,
  "code-runner.clearPreviousOutput": true,
  "code-runner.ignoreSelection": true,
  "code-runner.fileDirectoryAsCwd": true,
  "code-runner.executorMap": {
    "c":   "bash $workspaceRoot/.vscode/build.sh run $fullFileName $workspaceRoot",
    "cpp": "bash $workspaceRoot/.vscode/build.sh run $fullFileName $workspaceRoot"
  },

  // ---------- Competitive Programming Helper ----------
  "cph.general.defaultLanguage": "cpp",
  "cph.general.timeOut": 3000,
  "cph.language.c.Command": "gcc",
  "cph.language.c.Args": "-std=c17 -O2 -Wall -DLOCAL -lm",
  "cph.language.cpp.Command": "g++",
  "cph.language.cpp.Args": "-std=c++17 -O2 -Wall -Wshadow -DLOCAL"
}
