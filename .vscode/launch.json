{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug current file (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/.build/${fileBasename}.out",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${fileDirname}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "/usr/bin/gdb",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ],
      "preLaunchTask": "build-debug"
    }
  ]
}
